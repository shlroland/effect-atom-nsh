{
  "name": "effect-atom-nsh",
  "version": "1.0.0",
  "description": "NSH (Native Shell) bindings for Effect Atom",
  "type": "module",
  "license": "MIT",
  "author": "shlroland <shlroland1995@gmail.com>",
  "homepage": "https://github.com/shlroland/effect-atom-nsh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlroland/effect-atom-nsh.git"
  },
  "bugs": {
    "url": "https://github.com/shlroland/effect-atom-nsh/issues"
  },
  "keywords": [
    "effect",
    "atom",
    "nsh",
    "native-shell",
    "reactivity",
    "typescript"
  ],
  "sideEffects": [],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint -c .oxlintrc.json -f unix src test packages && dprint check",
    "lint-fix": "oxlint -c .oxlintrc.json --fix src test packages && dprint fmt",
    "check": "bun run lint && bun run check-types && bun run test",
    "effect:diagnostics": "effect-language-service diagnostics --format json",
    "prepare": "node ./scripts/prepare.mjs",
    "prepublishOnly": "bun run check",
    "pack:dry": "npm pack --dry-run --ignore-scripts",
    "trust:github": "npm trust github effect-atom-nsh --repo shlroland/effect-atom-nsh --file publish.yml -y",
    "release": "bumpp --commit --tag --push",
    "release:patch": "bumpp --release patch --commit --tag --push --yes",
    "release:minor": "bumpp --release minor --commit --tag --push --yes",
    "release:major": "bumpp --release major --commit --tag --push --yes"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@oxlint/plugins": "^1.93.0",
    "@types/bun": "latest",
    "bumpp": "^12.3.0",
    "dprint": "^0.64.3",
    "effect": "^4.1.4",
    "lefthook": "^2.2.2",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.4"
}
